# Copy to .dev.env (gitignored) and fill in secrets before running locally.
# Never commit real secrets.

# Required. API clients must send this value in the X-API-Key header.
API_KEY=dev-secret-key-change-me

# Required for chat inference. Sign up at openrouter.ai and get a free key.
# Only free models are permitted by default (see OPENROUTER_MODEL).
OPENROUTER_API_KEY=sk-or-...

# OpenRouter model pinned to a free variant. Verify it is on OpenRouter's
# free-models list before deployment: https://openrouter.ai/models
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_MODEL=cohere/north-mini-code:free # use this for fast reply (before using check if it is free or not)

# OpenRouter routing headers (recommended by OpenRouter)
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_X_TITLE=agent-api

# PostgreSQL (asyncpg, SQLAlchemy async). Use a Unix socket or TCP host.
# Example (Unix socket, local trust auth):
DATABASE_URL=postgresql+asyncpg://postgres@/agent_dev?host=%2Frun%2Fpostgresql
# Example (TCP):
# DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/agent_dev

# Test database (used by pytest conftest)
TEST_DATABASE_URL=postgresql+asyncpg://postgres@/agent_test?host=%2Frun%2Fpostgresql

# Security
CORS_ORIGINS=["*"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=262144
MAX_MESSAGE_LENGTH=4000

# Tavily (MCP-based web search, content extraction, crawling, research)
# Get a free key at https://tavily.com
TAVILY_API_KEY=tvly-your-key-here
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
